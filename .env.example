# Required: LinkedIn credentials for scraping job URLs
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# Optional: OpenAI API key (used by LangChain LLM)
OPENAI_API_KEY=sk-...

# Optional: Override the default LinkedIn search queries
# Set to comma-separated URLs, one per line:
# LINKEDIN_URLS=https://www.linkedin.com/jobs/search/...,https://www.linkedin.com/jobs/search/...